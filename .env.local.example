# ============================================================================
# KerimOS - Umgebungsvariablen
#
# Kopieren nach .env.local und die leeren Werte ausfüllen. Dieselben Werte
# müssen in Vercel unter Settings -> Environment Variables stehen; nach einer
# Änderung dort ist ein Redeploy nötig, sonst greift sie nicht.
# ============================================================================

# --- KerimOS: eigene Datenbank (Supabase-Projekt "Kompass") -----------------
# Öffentliche Werte. Der Schutz kommt aus Row Level Security, nicht aus der
# Geheimhaltung des Schlüssels - deshalb dürfen sie NEXT_PUBLIC_ heissen.
NEXT_PUBLIC_SUPABASE_URL=https://fhgrjqvunxbfhujoxmcn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CqgN4ZIFWzfLYfYEc9UWkA_x3-JpFc3

# --- Gym-Tracker und Menüplan (Supabase-Projekt "Gymapp Cursor") ------------
# Beide Apps teilen sich diese Datenbank. KerimOS liest serverseitig mit einem
# eigenen Schlüssel, weil ein in KerimOS angemeldeter Nutzer dort nicht
# existiert und sonst keine Zeile sähe.
#
# ACHTUNG: kein NEXT_PUBLIC_ davor. Der service_role-Schlüssel umgeht sämtliche
# Zugriffsregeln dieser Datenbank und darf den Browser nie erreichen. Die drei
# Zugangsmodule tragen deshalb `import "server-only"` - ein versehentlicher
# Client-Import lässt den Build abbrechen, statt den Schlüssel auszuliefern.
# Zu finden unter: Supabase -> Projekt "Gymapp Cursor" -> Settings -> API Keys.
GYM_SUPABASE_URL=https://kvpexrorkqmxnzqvexga.supabase.co
GYM_SUPABASE_SERVICE_ROLE_KEY=

# Besitzer der Zeilen in der Gym-Datenbank. Ohne diesen Wert versucht KerimOS,
# die Kennung vom letzten bestehenden Gewichtseintrag zu übernehmen.
GYM_USER_ID=ee03c0de-0bc3-4150-8a1e-eba6406ccade

# Nur nötig, falls der Menüplan je in ein eigenes Supabase-Projekt umzieht.
# Solange er in der Gym-Datenbank liegt, leer lassen - dann greift der
# Gym-Zugang von oben automatisch.
MENU_SUPABASE_URL=
MENU_SUPABASE_ANON_KEY=

# --- Trading: GVA-Screener und Backtests ------------------------------------
# Dieselbe Datenbank, die der GVA-Screener nutzt: Backtest-Sessions, Hit-
# Historie und der Wirtschaftskalender. Ebenfalls service_role, ebenfalls
# niemals NEXT_PUBLIC_.
# Zu finden unter: Supabase -> Projekt kerimtrades.ssg -> Settings -> API Keys.
TRADING_SUPABASE_URL=https://bpggwelpuvbkeudrqoiv.supabase.co
TRADING_SUPABASE_SERVICE_ROLE_KEY=

# Live-Board des Screeners (FastAPI auf Render). Der Standardwert stimmt -
# nur setzen, wenn das Backend je umzieht.
GVA_API_URL=https://gva-screener.onrender.com

# --- Push-Benachrichtigungen (PWA auf dem Handy) ----------------------------
# VAPID-Schluesselpaar: weist KerimOS gegenueber Googles Push-Dienst als
# Absender aus. Einmalig erzeugt, danach nie wechseln - sonst muessen sich
# alle Geraete neu anmelden. Neu erzeugen liesse sich das Paar mit:
#   npx web-push generate-vapid-keys
# Der oeffentliche Teil landet bewusst im Browser (NEXT_PUBLIC_), der
# private darf ausschliesslich auf dem Server existieren.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kerimtrades.ssg@gmail.com

# --- Schutz der Cron-Endpunkte ----------------------------------------------
# Frei erfundener Wert, nichts zum Nachschlagen - einfach eine lange
# Zufallsfolge, z.B. aus:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Schuetzt /api/garmin-sync und /api/gva-alarm. Vercel haengt ihn bei eigenen
# Cron-Aufrufen automatisch als "Authorization: Bearer <Wert>" an; externe
# Taktgeber (cron-job.org fuer den GVA-Alarm) haengen ihn als ?secret=<Wert>
# an die URL.
#
# ACHTUNG: Solange die Variable leer ist, lassen BEIDE Endpunkte jeden
# Aufrufer durch. Das ist Absicht fuer die lokale Entwicklung, in Vercel
# sollte sie gesetzt sein.
CRON_SECRET=
