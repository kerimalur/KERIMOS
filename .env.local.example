# --- Gym-Tracker: nur lesender Zugang für den Bereich "Gym" ---------------
# Der Gym-Tracker liegt in einer eigenen Supabase-Datenbank mit eigener
# Anmeldung. Ein in KerimOS angemeldeter Nutzer existiert dort nicht, deshalb
# greift KerimOS serverseitig mit einem eigenen Schlüssel zu.
#
# ACHTUNG: kein NEXT_PUBLIC_ davor. Der service_role-Schlüssel umgeht alle
# Zugriffsregeln der Gym-Datenbank und darf den Browser nie erreichen.
# Zu finden unter: Supabase → Projekt "Gymapp Cursor" → Settings → API Keys.
GYM_SUPABASE_URL=https://kvpexrorkqmxnzqvexga.supabase.co
GYM_SUPABASE_SERVICE_ROLE_KEY=
