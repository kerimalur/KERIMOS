{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "functions": {
    "api/garmin-sync.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/garmin-sync",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/gva-alarm",
      "schedule": "*/5 * * * *"
    }
  ]
}
